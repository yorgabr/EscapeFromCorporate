  <command:command xmlns:maml="http://schemas.microsoft.com/maml/2004/10" xmlns:command="http://schemas.microsoft.com/maml/dev/command/2004/10" xmlns:dev="http://schemas.microsoft.com/maml/dev/2004/10" xmlns:MSHelp="http://msdn.microsoft.com/mshelp">
    <command:details>
      <command:name>Resume-EfcJob</command:name>
      <command:verb>Resume</command:verb>
      <command:noun>EfcJob</command:noun>
      <maml:description>
        <maml:para>Resumes an interrupted efc job from its persisted state.</maml:para>
      </maml:description>
    </command:details>
    <maml:description>
      <maml:para>Convenience wrapper that reads the persisted state and re-invokes Invoke-EfcJob using the stored source/destination signatures, continuing from the last checkpoint offset. Fails if no resumable state exists. If the matching job is already completed, it reports so and returns the state without further work.</maml:para>
    </maml:description>
    <command:syntax>
      <command:syntaxItem>
        <maml:name>Resume-EfcJob</maml:name>
        <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="0" aliases="none">
          <maml:name>StateRoot</maml:name>
          <maml:description>
            <maml:para>Override for the state directory. Defaults to $env:LOCALAPPDATA\EscapeFromCorporate.</maml:para>
          </maml:description>
          <command:parameterValue required="true" variableLength="false">String</command:parameterValue>
          <dev:type>
            <maml:name>String</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>$env:LOCALAPPDATA\EscapeFromCorporate</dev:defaultValue>
        </command:parameter>
      </command:syntaxItem>
    </command:syntax>
    <command:parameters>
      <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="0" aliases="none">
        <maml:name>StateRoot</maml:name>
        <maml:description>
          <maml:para>Override for the state directory. Defaults to $env:LOCALAPPDATA\EscapeFromCorporate.</maml:para>
        </maml:description>
        <command:parameterValue required="true" variableLength="false">String</command:parameterValue>
        <dev:type>
          <maml:name>String</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>$env:LOCALAPPDATA\EscapeFromCorporate</dev:defaultValue>
      </command:parameter>
    </command:parameters>
    <command:inputTypes>
      <command:inputType>
        <dev:type>
          <maml:name>None</maml:name>
        </dev:type>
        <maml:description>
          <maml:para></maml:para>
        </maml:description>
      </command:inputType>
    </command:inputTypes>
    <command:returnValues>
      <command:returnValue>
        <dev:type>
          <maml:name>System.Management.Automation.PSCustomObject</maml:name>
        </dev:type>
        <maml:description>
          <maml:para>The final job state after resumption.</maml:para>
        </maml:description>
      </command:returnValue>
    </command:returnValues>
    <maml:alertSet>
      <maml:alert>
        <maml:para>Author  : Yorga Babuscan &lt;yorgabr@gmail.com&gt; License : Apache License 2.0</maml:para>
        <maml:para>Throws when no persisted job state exists.</maml:para>
      </maml:alert>
    </maml:alertSet>
    <command:examples>
      <command:example>
        <maml:title>---- Example 1: Resume the most recent interrupted transfer ----</maml:title>
        <dev:code>Resume-EfcJob</dev:code>
        <dev:remarks>
          <maml:para>Reads the persisted state and continues the transfer from the last checkpoint.</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-- Example 2: Resume a job stored in a custom state location --</maml:title>
        <dev:code>Resume-EfcJob -StateRoot 'D:\efc-state'</dev:code>
        <dev:remarks>
          <maml:para>Resumes using a non-default state directory (useful for isolated or test setups).</maml:para>
        </dev:remarks>
      </command:example>
