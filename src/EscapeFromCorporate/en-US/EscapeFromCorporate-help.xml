    <command:examples>
      <command:example>
        <maml:title>----------- Example 1: Basic transfer to a NAS share -----------</maml:title>
        <dev:code>Invoke-EfcJob -Source 'C:\Users\me\CorporateData' -Destination '\\HOME-NAS\Backup\Dump'</dev:code>
        <dev:remarks>
          <maml:para>Starts (or resumes) a secure copy to the home NAS, rendering live progress and accepting P/R/A keystrokes at runtime.</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------- Example 2: Project the workload before copying --------</maml:title>
        <dev:code>Invoke-EfcJob -Source 'C:\Data' -Destination 'D:\Backup' -DryRun</dev:code>
        <dev:remarks>
          <maml:para>Projects how many files and bytes would be copied, without transferring anything.</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>--------------- Example 3: Force a clean restart ---------------</maml:title>
        <dev:code>Invoke-EfcJob -Source 'C:\Data' -Destination '\\NAS\Dump' -Force</dev:code>
        <dev:remarks>
          <maml:para>Ignores any prior state and starts a completely fresh transfer.</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>Example 4: Restartable mode over a flaky link (using the alias)</maml:title>
        <dev:code>efc -Source 'C:\Data' -Destination '\\NAS\Dump' -Restartable</dev:code>
        <dev:remarks>
          <maml:para></maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>Example 5: High-assurance transfer with sampled content verification</maml:title>
        <dev:code>Invoke-EfcJob -Source 'C:\Legal\Case' -Destination '\\NAS\Vault' -SampleHashCount 200</dev:code>
        <dev:remarks>
          <maml:para>After copying, verifies 200 randomly selected files by SHA256 at both source and destination. Any content mismatch fails validation and blocks the safe-to-delete signal.</maml:para>
          <maml:para>Uses the 'efc' alias with restartable mode (robocopy /Z) for large files over an unreliable network.</maml:para>
        </dev:remarks>
      </command:example>
    </command:examples>
