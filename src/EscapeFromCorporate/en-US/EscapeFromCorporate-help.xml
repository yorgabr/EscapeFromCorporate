  <command:command xmlns:maml="http://schemas.microsoft.com/maml/2004/10" xmlns:command="http://schemas.microsoft.com/maml/dev/command/2004/10" xmlns:dev="http://schemas.microsoft.com/maml/dev/2004/10" xmlns:MSHelp="http://msdn.microsoft.com/mshelp">
    <command:details>
      <command:name>Invoke-EfcJob</command:name>
      <command:verb>Invoke</command:verb>
      <command:noun>EfcJob</command:noun>
      <maml:description>
        <maml:para>Securely copies a directory tree to a destination (local or UNC) with resumable, validated, progress-tracked transfers powered by robocopy.</maml:para>
      </maml:description>
    </command:details>
    <maml:description>
      <maml:para>Invoke-EfcJob is the primary controller for Escape From Corporate. It orchestrates the full lifecycle of a secure file dump:</maml:para>
      <maml:para>1. Pre-flight validation and (optionally) a DryRun projection of pending work. 2. Idempotent resumption reconciliation against any persisted state.json. 3. Background robocopy spawn with file-based logging (no pipe deadlock). 4. A non-blocking watch loop rendering a live spinner, ETA, percentage, and throughput, while capturing P/R/A keystrokes for Pause/Resume/Abort. 5. Atomic checkpoint persistence to allow interrupted jobs to resume exactly. 6. Post-copy integrity validation and a clear "safe to delete" signal.</maml:para>
      <maml:para>The utility is designed for locked-down corporate Windows 11 environments with no administrator privileges and no third-party sync tools; it relies solely on native PowerShell 5.1 and robocopy.exe.</maml:para>
    </maml:description>
    <command:syntax>
      <command:syntaxItem>
        <maml:name>Invoke-EfcJob</maml:name>
        <command:parameter required="true" variableLength="true" globbing="false" pipelineInput="False" position="0" aliases="none">
          <maml:name>Source</maml:name>
          <maml:description>
            <maml:para>Absolute path to the source directory to copy from.</maml:para>
          </maml:description>
          <command:parameterValue required="true" variableLength="false">String</command:parameterValue>
          <dev:type>
            <maml:name>String</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>None</dev:defaultValue>
        </command:parameter>
        <command:parameter required="true" variableLength="true" globbing="false" pipelineInput="False" position="1" aliases="none">
          <maml:name>Destination</maml:name>
          <maml:description>
            <maml:para>Destination directory. Supports local paths and UNC shares (\server\share\...).</maml:para>
          </maml:description>
          <command:parameterValue required="true" variableLength="false">String</command:parameterValue>
          <dev:type>
            <maml:name>String</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>None</dev:defaultValue>
        </command:parameter>
        <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="nomeado" aliases="cf">
          <maml:name>Confirm</maml:name>
          <maml:description>
            <maml:para>Prompts you for confirmation before running the cmdlet.</maml:para>
          </maml:description>
          <dev:type>
            <maml:name>SwitchParameter</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>False</dev:defaultValue>
        </command:parameter>
        <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="nomeado" aliases="none">
          <maml:name>DryRun</maml:name>
          <maml:description>
            <maml:para>Enumerates the pending work via 'robocopy /L' without copying anything, printing the projected file count and total bytes. Useful for sizing and validation.</maml:para>
          </maml:description>
          <dev:type>
            <maml:name>SwitchParameter</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>False</dev:defaultValue>
        </command:parameter>
        <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="nomeado" aliases="none">
          <maml:name>Force</maml:name>
          <maml:description>
            <maml:para>Discards any existing job state for this source/destination pair and starts a clean transfer. Without -Force, a matching incomplete job is resumed.</maml:para>
          </maml:description>
          <dev:type>
            <maml:name>SwitchParameter</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>False</dev:defaultValue>
        </command:parameter>
        <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="nomeado" aliases="none">
          <maml:name>Restartable</maml:name>
          <maml:description>
            <maml:para>Enables robocopy restartable mode (/Z) for resilient resumption of large files over unreliable network links. Slightly slower but far more robust.</maml:para>
          </maml:description>
          <dev:type>
            <maml:name>SwitchParameter</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>False</dev:defaultValue>
        </command:parameter>
        <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="nomeado" aliases="none">
          <maml:name>SampleHashCount</maml:name>
          <maml:description>
            <maml:para>Number of files to sample for SHA256 content verification during the post-copy integrity check. 0 (default) uses robocopy differential list validation only. Higher values add content-level assurance at the cost of hashing that many random files at both the source and destination.</maml:para>
          </maml:description>
          <command:parameterValue required="true" variableLength="false">Int32</command:parameterValue>
          <dev:type>
            <maml:name>Int32</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>0</dev:defaultValue>
        </command:parameter>
        <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="nomeado" aliases="none">
          <maml:name>StateRoot</maml:name>
          <maml:description>
            <maml:para>Overrides the state directory. Defaults to $env:LOCALAPPDATA\EscapeFromCorporate. Primarily an injection seam for testing.</maml:para>
          </maml:description>
          <command:parameterValue required="true" variableLength="false">String</command:parameterValue>
          <dev:type>
            <maml:name>String</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>$env:LOCALAPPDATA\EscapeFromCorporate</dev:defaultValue>
        </command:parameter>
        <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="nomeado" aliases="wi">
          <maml:name>WhatIf</maml:name>
          <maml:description>
            <maml:para>Shows what would happen if the cmdlet runs. The cmdlet is not run.</maml:para>
          </maml:description>
          <dev:type>
            <maml:name>SwitchParameter</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>False</dev:defaultValue>
        </command:parameter>
      </command:syntaxItem>
    </command:syntax>
