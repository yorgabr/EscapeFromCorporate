    <command:details>
      <command:name>Clear-EfcState</command:name>
      <command:verb>Clear</command:verb>
      <command:noun>EfcState</command:noun>
      <maml:description>
        <maml:para>Removes the persisted efc job state (and optionally its logs).</maml:para>
      </maml:description>
    </command:details>
    <maml:description>
      <maml:para>Deletes state.json and its sidecar files (.tmp, .bak). With -IncludeLogs, also purges the logs directory. Supports -WhatIf and -Confirm via ShouldProcess with High confirm impact. Use before starting an unrelated job or to reclaim space after a validated, deleted transfer.</maml:para>
    </maml:description>
